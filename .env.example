# Versand der Rezept- und Überweisungsanfragen.
#
# Ohne diese Werte sendet die Website nichts. Das Formular zeigt dann eine
# Fehlermeldung mit der Telefonnummer, statt eine Anfrage stillschweigend zu
# verschlucken.
#
# WICHTIG vor dem Livegang:
#   - Postfach auf eigener Domain, nicht bei einem Freemail-Anbieter.
#   - Auftragsverarbeitungsvertrag mit dem E-Mail-Anbieter. Ohne AV-Vertrag
#     dürfen dort keine Patientendaten verarbeitet werden.
#   - Port 587 mit STARTTLS oder 465 mit TLS. Die Anwendung erzwingt TLS und
#     bricht ab, wenn keine verschlüsselte Verbindung zustande kommt.

SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=praxis@example.de
SMTP_PASS=

# Postfach, in dem die Anfragen ankommen sollen.
ANFRAGE_EMPFAENGER=praxis@example.de

# Online-Terminbuchung (optional).
#
# Solange APPOINTMENT_PROVIDER_URL fehlt, gibt es auf der Website keinen
# „Termin buchen"-Button — es gilt der Telefonweg. Erst wenn die Praxis
# einen Vertrag mit einem Anbieter (z. B. Doctolib) hat, den offiziellen
# Buchungslink hier eintragen. Beides zusammen setzen: Der Anbietername
# steht sichtbar an jedem Buchungslink.
#
# APPOINTMENT_EMBED_ENABLED ist für eine spätere Ausbaustufe reserviert
# (eingebettete Buchung nach Einwilligung); derzeit ohne Wirkung.

APPOINTMENT_PROVIDER_URL=
APPOINTMENT_PROVIDER_NAME=
APPOINTMENT_EMBED_ENABLED=false

# WhatsApp-Business-Kontakt (Vorschau).
#
# Internationales Format ohne Sonderzeichen, z. B. 4915712345678.
# Ohne diesen Wert zeigt die WhatsApp-Sektion eine klar gekennzeichnete
# Vorschau, und der Button sendet nichts — es gibt keine erfundene Nummer.
# Mit Wert öffnet der Button einen einfachen wa.me-Link mit der
# vorbelegten Rückrufbitte (keine medizinischen Angaben).

WHATSAPP_BUSINESS_NUMBER=
