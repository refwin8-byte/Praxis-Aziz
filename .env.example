# Versand der Rezept- und Überweisungsanfragen.
#
# Ohne diese Werte sendet die Website nichts. Das Formular zeigt dann eine
# Fehlermeldung mit der Telefonnummer, statt eine Anfrage stillschweigend zu
# verschlucken.
#
# WICHTIG vor dem Livegang:
#   - Postfach auf eigener Domain, nicht bei einem Freemail-Anbieter.
#   - Auftragsverarbeitungsvertrag mit dem E-Mail-Anbieter. Ohne AV-Vertrag
#     dürfen dort keine Patientendaten verarbeitet werden.
#   - Port 587 mit STARTTLS oder 465 mit TLS. Die Anwendung erzwingt TLS und
#     bricht ab, wenn keine verschlüsselte Verbindung zustande kommt.

SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=praxis@example.de
SMTP_PASS=

# Postfach, in dem die Anfragen ankommen sollen.
ANFRAGE_EMPFAENGER=praxis@example.de
